{
  "name": "v-region",
  "description": "Provide Chinese administrative division data selection",
  "version": "3.5.2",
  "author": "TerryZ <terry5@foxmail.com>",
  "type": "module",
  "files": [
    "./dist",
    "./types"
  ],
  "main": "./dist/v-region.umd.cjs",
  "module": "./dist/v-region.js",
  "packageManager": "pnpm@11.22.0",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./dist/v-region.js"
      },
      "require": "./dist/v-region.umd.cjs"
    }
  },
  "typings": "./types/index.d.ts",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "coverage": "vitest run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "dts": "vue-tsc --declaration --emitDeclarationOnly",
    "format": "prettier --write --experimental-cli src/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TerryZ/v-region.git"
  },
  "dataVersion": "2026-03-25",
  "keywords": [
    "front-end",
    "web",
    "vue",
    "region",
    "city",
    "town",
    "area",
    "selector"
  ],
  "peerDependencies": {
    "vue": "^3.5.39"
  },
  "dependencies": {
    "v-dropdown": "^3.5.1",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/eslint-config-standard": "^8.0.1",
    "bootstrap": "^5.3.8",
    "sass": "^1.93.2",
    "postcss": "^8.5.6",
    "autoprefixer": "^10.4.21",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vue-router": "^4.5.1",
    "vite-plugin-dts": "^4.5.4",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.74.0",
    "prettier": "3.9.5",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}